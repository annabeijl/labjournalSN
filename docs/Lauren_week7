# In class
## Changing effects in model
```{r}
gender_covar <- coCovar(gender)
mydata_1 <- sienaDataCreate(nety, gender_covar, behy)
myeff_2 <- getEffects(mydata_1)

myeff_2 <- includeEffects(myeff_2, absDiffX, interaction1 = "gender_covar")

# General effects
myeff_2 <- includeEffects(myeff_1, egoX, altX, absDiffX, interaction1 = "behy")

# Adding influence effects for indegree, outdegree and assimilation
myeff_2 <- includeEffects(myeff_2, name = "behy", avAlt, indeg, outdeg, interaction1 = "nety")

# Set algorithm
myCoEvAlgorithm <- sienaAlgorithmCreate(projname = "test")
```

Running the model

```{r, eval=FALSE}
model_week7_2 <- siena07(myCoEvAlgorithm, data = mydata_1, effects = myeff_2)
```

```{r, include = FALSE}
saveRDS(model_week7_2, "model_week7_2.rds")
model_week7_2 <- readRDS("model_week7_2.rds")
```

```{r}
model_week7_2

# All convergence t-ratio should be <.1 --> is not met (eval behy sim = 0.2001 &  eval behy abs. difference = 0.1971)
# Overall max convergence ratio should be <.25 --> is not met (ratio = 2.4452)
```

