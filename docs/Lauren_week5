## Data prep for RSiena
### Behavioural data in matrix
```{r}
IC_df <- IC_df %>% 
  rownames_to_column(var = "id") 

IC_df2 <- IC_df2 %>% 
  rownames_to_column(var = "id") 

IC_df <- left_join(IC_df, IC_df2, by=c("id"))

behy <- IC_df %>% 
  dplyr::select("ce_t1", "ce_t2") %>% 
  as.matrix()
```

### Make RSiena object
```{r}
behy <- sienaDependent(behy, type = c("behavior"))

nety <- sienaDependent(array(data= c(strong_netw_t1, strong_netw_t2), dim=c(dim(strong_netw_t1),2)))

# Into one (RSiena) data frame
mydata <- sienaDataCreate(behy, nety)

myAlgorithm <- sienaAlgorithmCreate(projname = "test")
print01Report(mydata, modelname = "./results/test")
```

### Simple model
```{r}
myeff <- getEffects(mydata)
ans <- siena07(myAlgorithm, data = mydata, effects = myeff, returnDeps = TRUE)
```

### Changing the effects/ statistics
```{r}
myeff <- includeEffects(myeff, avAlt, name = "behy", interaction1="nety") # You use nety to predict behy

ans <- siena07(myAlgorithm, data = mydata, effects = myeff, returnDeps = TRUE)

ans
```



